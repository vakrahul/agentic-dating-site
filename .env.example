# LLM provider: gemini | cerebras
LLM_PROVIDER=gemini

# Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash

# Cerebras (used when LLM_PROVIDER=cerebras)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# Apify scraping
APIFY_TOKEN=
LINKEDIN_ACTOR_ID=linkedintel-core/linkedin-profile-scraper-no-cookies

# Optional overrides
# DATABASE_URL=sqlite+aiosqlite:///./proxy.db
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# SCRAPE_CONCURRENCY=5
# ANALYSIS_CONCURRENCY=4
# DATE_CONCURRENCY=10
